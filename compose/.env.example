# Allow new user registrations in Vaultwarden (set to false after creating your account)
VAULTWARDEN_SIGNUPS_ALLOWED=true

# Token for the Vaultwarden admin page (http://localhost:8080/admin)
# Use a long random string
VAULTWARDEN_ADMIN_TOKEN=change-me

# Password for Gitea's Postgres database
GITEA_DB_PASSWORD=change-me

# Gitea secret key (encrypts sessions and stored secrets). Use a long random string
GITEA_SECRET_KEY=change-me
